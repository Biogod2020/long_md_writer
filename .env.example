# Required for the Agents SDK manager and Codex CLI wrapper.
OPENAI_API_KEY=
# CODEX_API_KEY may be used instead for the Codex subprocess.
CODEX_API_KEY=
# Optional OpenAI-compatible endpoint.
OPENAI_BASE_URL=
# Optional explicit Codex binary.
CODEX_PATH=
# Optional model overrides used by the integration smoke test.
ORCHESTRATOR_MODEL=gpt-5.6-sol
CODEX_MODEL=gpt-5.3-codex
