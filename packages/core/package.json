{
  "name": "@longwriter/core",
  "version": "0.2.0",
  "description": "Harness-agnostic publication kernel for LongWriter",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./svg": "./svg/index.js",
    "./project-store": "./lib/project-store.js",
    "./validator": "./lib/validator-runner.js"
  },
  "files": [
    "index.js",
    "src",
    "lib",
    "svg",
    "python"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@xmldom/xmldom": "^0.9.11"
  },
  "scripts": {
    "check": "node --check index.js && node --check src/*.js && node --check src/svg/*.js && python3 -m py_compile python/validate_publication.py",
    "test:node": "node --test test/*.test.js",
    "test:python": "python3 -m unittest discover -s test -p 'test_*.py'",
    "test": "pnpm run check && pnpm run test:node && pnpm run test:python"
  }
}
